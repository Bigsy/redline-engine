{
  "name": "redline-engine",
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "description": "Structural HTML redlines with validated before/after reconstruction, precise inline highlights and bounded failure.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CONTRACT.md",
    "COMPATIBILITY.md",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md",
    "examples"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "playground": "vite --config playground/vite.config.ts",
    "bench": "pnpm run build && node --experimental-strip-types bench/run.ts",
    "test:browser": "playwright test",
    "playground:build": "vite build --config playground/vite.config.ts",
    "test:integration": "node test/integration/run.mjs",
    "format:check": "prettier --check src test scripts examples bench/*.ts bench/*.mjs playground/*.{ts,html,css} *.json *.ts",
    "bench:sibling": "pnpm run build && node bench/sibling.mjs",
    "test:upstream": "vitest run --config vitest.upstream.config.ts",
    "test:compatibility": "vitest run --config vitest.compatibility.config.ts",
    "bench:stage3": "pnpm run build && node bench/stage3-node.mjs && STAGE3_EXTRA=1 node bench/stage3-node.mjs && node bench/stage3-browser.mjs && STAGE3_EXTRA=1 node bench/stage3-browser.mjs && node bench/stage3-stress.mjs && node bench/stage3-summary.mjs",
    "prepack": "npm run build",
    "test:package": "node test/package/run.mjs",
    "bench:memory": "node bench/release-memory.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "dompurify": "^3.4.14",
    "happy-dom": "^20.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.5.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "parse5": "8.0.1"
  },
  "author": "Bill Hedworth",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "html",
    "diff",
    "redline",
    "structural-diff",
    "typescript"
  ]
}
